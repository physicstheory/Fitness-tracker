{
  "name": "reprise",
  "version": "1.0.0",
  "description": "RepRise: rep tracker with rest timers, AI program import and AI coaching",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/physicstheory/Fitness-tracker.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/physicstheory/Fitness-tracker/issues"
  },
  "homepage": "https://github.com/physicstheory/Fitness-tracker#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "private": true,
  "type": "module"
}
